TYPE "UDT_RobotCommand"
VERSION : 0.1
   STRUCT
      JobRequest : Bool;
      JobID : UInt;
      SequenceID : UInt;
      HoldRequest : Bool;
      ResetRequest : Bool;
      MotionPermit : Bool;
      DoneAck : Bool;
   END_STRUCT;

END_TYPE

TYPE "UDT_RobotStatus"
VERSION : 0.1
   STRUCT
      Ready : Bool;
      JobAccepted : Bool;
      AcceptedSequenceID : UInt;
      Busy : Bool;
      JobDone : Bool;
      Fault : Bool;
      FaultCode : UInt;
      AtHome : Bool;
      AtSafePosition : Bool;
      GripperClosed : Bool;
   END_STRUCT;

END_TYPE

DATA_BLOCK "DB_RobotIO"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
NON_RETAIN
   VAR 
      Command { S7_SetPoint := 'False'} : "UDT_RobotCommand";
      Status : "UDT_RobotStatus";
   END_VAR


BEGIN

END_DATA_BLOCK

DATA_BLOCK "DB_SimControl"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
NON_RETAIN
   VAR 
      DisableJobAcceptance : Bool;   // Prevent robot acknowledgment
      FreezeRobotExecution : Bool;   // Prevent job timer from progressing
      EnableFaultInjection : Bool;   // Master enable for fault simulation
      RejectUnloadJob : Bool;
      InjectMachiningFault : Bool;
   END_VAR


BEGIN

END_DATA_BLOCK

TYPE "UDT_CNCCommand"
VERSION : 0.1
   STRUCT
      OpenDoor : Bool;
      CloseDoor : Bool;
      ClampChuck : Bool;
      UnclampChuck : Bool;
      StartCycle : Bool;
      ResetFault : Bool;
      RobotClear : Bool;
      SimLoadPart : Bool;
      SimUnloadPart : Bool;
   END_STRUCT;

END_TYPE

TYPE "UDT_CNCStatus"
VERSION : 0.1
   STRUCT
      DoorOpen : Bool;
      DoorClosed : Bool := True;
      ChuckClamped : Bool;
      ChuckUnclamped : Bool;
      PartPresent : Bool;
      MachineReady : Bool := True;
      CycleRunning : Bool;
      CycleComplete : Bool;
      Fault : Bool;
      FaultCode : UInt;
      MachineState : Int;
   END_STRUCT;

END_TYPE

FUNCTION_BLOCK "FB_RobotSimulator"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR 
      State : Int;   // Current robot state
      ActiveJobID : UInt;   // Latched job number
      ActiveSequenceID : UInt;   // Latched sequence number
      JobTimer {InstructionName := 'TON_TIME'; LibVersion := '1.0'; S7_SetPoint := 'False'} : TON_TIME;   // Simulated execution time
   END_VAR


BEGIN
	
	// FB_RobotSimulator
	// Version 0.1 - Virtual robot controller
	// Simulation only - not safety-rated logic
	
	// Execute the timer on every PLC scan
	
	#JobTimer(
	          IN := (#State = 20)
	            AND NOT "DB_RobotIO".Command.HoldRequest
	             AND NOT (
	                "DB_SimControl".EnableFaultInjection
	                AND "DB_SimControl".FreezeRobotExecution
	                ),
	          PT := T#3s
	);
	
	
	// Default outputs for each scan
	"DB_RobotIO".Status.Ready := FALSE;
	"DB_RobotIO".Status.JobAccepted := FALSE;
	"DB_RobotIO".Status.Busy := FALSE;
	"DB_RobotIO".Status.JobDone := FALSE;
	
	// Simulated robot position
	"DB_RobotIO".Status.AtHome := TRUE;
	"DB_RobotIO".Status.AtSafePosition := TRUE;
	"DB_RobotIO".Status.GripperClosed := FALSE;
	
	
	// Simulation-only reset/abort.
	// Allows recovery from a stalled virtual robot.
	
	IF "DB_RobotIO".Command.ResetRequest
	    AND NOT "DB_RobotIO".Command.JobRequest THEN
	    
	    #State := 0;
	    #ActiveJobID := UINT#0;
	    #ActiveSequenceID := UINT#0;
	    
	    "DB_RobotIO".Status.Fault := FALSE;
	    "DB_RobotIO".Status.FaultCode := UINT#0;
	    "DB_RobotIO".Status.AcceptedSequenceID := UINT#0;
	    
	END_IF;
	
	
	CASE #State OF
	        
	        
	        
	    0: // IDLE - WAIT FOR ROBOT JOB REQUEST
	        
	        // Default robot idle status
	        "DB_RobotIO".Status.Ready := TRUE;
	        "DB_RobotIO".Status.Busy := FALSE;
	        "DB_RobotIO".Status.JobDone := FALSE;
	        "DB_RobotIO".Status.JobAccepted := FALSE;
	        
	        // Check for incoming robot job
	        IF "DB_RobotIO".Command.JobRequest
	            AND "DB_RobotIO".Command.MotionPermit
	            
	            // Reject all jobs when enabled
	            AND NOT (
	            "DB_SimControl".EnableFaultInjection
	            AND "DB_SimControl".DisableJobAcceptance
	            )
	            
	            // Reject only Job 20 when enabled
	            AND NOT (
	            "DB_SimControl".EnableFaultInjection
	            AND "DB_SimControl".RejectUnloadJob
	            AND ("DB_RobotIO".Command.JobID = UINT#20)
	            )
	            
	        THEN
	            
	            // Validate job ID
	            IF ("DB_RobotIO".Command.JobID = UINT#10)
	                OR ("DB_RobotIO".Command.JobID = UINT#20)
	                OR ("DB_RobotIO".Command.JobID = UINT#30) THEN
	                
	                // Store accepted job
	                #ActiveJobID :=
	                "DB_RobotIO".Command.JobID;
	                
	                #ActiveSequenceID :=
	                "DB_RobotIO".Command.SequenceID;
	                
	                // Publish accepted sequence ID
	                "DB_RobotIO".Status.AcceptedSequenceID :=
	                #ActiveSequenceID;
	                
	                // Advance to acceptance handshake
	                #State := 10;
	                
	            ELSE
	                
	                // Invalid robot job
	                "DB_RobotIO".Status.FaultCode := UINT#100;
	                #State := 90;
	                
	            END_IF;
	            
	        END_IF;
	        
	        
	        
	    10: // WAIT FOR REQUEST CLEAR
	        "DB_RobotIO".Status.JobAccepted := TRUE;
	        
	        IF NOT "DB_RobotIO".Command.JobRequest THEN
	            #State := 20;
	        END_IF;
	        
	    20: // EXECUTING
	        "DB_RobotIO".Status.Busy := TRUE;
	        
	        IF #JobTimer.Q THEN
	            #State := 30;
	        END_IF;
	        
	    30: // WAIT FOR COMPLETION ACK
	        "DB_RobotIO".Status.JobDone := TRUE;
	        
	        IF "DB_RobotIO".Command.DoneAck THEN
	            #State := 40;
	        END_IF;
	        
	    40: // WAIT FOR ACK CLEAR
	        IF NOT "DB_RobotIO".Command.DoneAck
	            AND NOT "DB_RobotIO".Command.JobRequest THEN
	            
	            #State := 0;
	        END_IF;
	        
	    90: // FAULT
	        "DB_RobotIO".Status.Fault := TRUE;
	        
	    ELSE
	        "DB_RobotIO".Status.Fault := TRUE;
	        "DB_RobotIO".Status.FaultCode := UINT#999;
	        #State := 90;
	        
	END_CASE;
	
END_FUNCTION_BLOCK

